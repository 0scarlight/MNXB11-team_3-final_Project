# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Contents of the external folder should not be in git
external/*

# Contents of the build folder should not be in git
build/*

# Resulting ROOT files should not be in git
results/*

# Don't add the argumentum library to git
argumentum*

# Don't add the main executable to git
main

# Ignore the uncompressed datasets
datasets/*

# Ignore the testing folder
planing_structure/testing/*

# Ignore changes to the cleaning scripts
scripts/data_cleaning/*

# Ignore file generated during the LaTeX compilation
LaTeX/*.aux
LaTeX/*.bbl
LaTeX/*.bcf
LaTeX/*.blg
LaTeX/*.fdb_latexmk
LaTeX/*.fls
LaTeX/*.log
LaTeX/*.out
LaTeX/*.run.xml
LaTeX/*.synctex.gz
LaTeX/*.toc
LaTeX/*.lof
LaTeX/*.lot
LaTeX/*.nav
LaTeX/*.snm
LaTeX/*.vrb
LaTeX/*.xdv

